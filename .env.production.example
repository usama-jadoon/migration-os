# MigrationOS Production Environment Configuration Example

NODE_ENV=production
PORT=4000

# Database Provider Configuration ('sqlite' or 'postgresql')
DATABASE_PROVIDER=postgresql
DATABASE_URL=postgresql://migrationos:your_secure_postgres_password@db:5432/migrationos_db?schema=public

# Queue Provider Configuration ('memory' or 'redis')
QUEUE_PROVIDER=redis
REDIS_URL=redis://redis:6379

# Security & Encryption Key (Must be at least 32 characters in production)
ENCRYPTION_KEY=replace_with_a_random_32_character_string_here

# Worker Concurrency Settings
WORKER_CONCURRENCY=5

# Web Client Configuration
NEXT_PUBLIC_API_URL=http://localhost:4000
